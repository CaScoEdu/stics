---
interface Props {
  title?: string;
  message?: string;
  hideLabel?: string;
  showLabel?: string;
}

const isEn = Astro.url.pathname.startsWith('/en/');

const {
  title = isEn ? 'Reading tip' : 'Suggerimento di lettura',
  message = isEn
    ? 'This diagram is easier to read with more horizontal space. You can hide the right sidebar while studying it and reopen it afterwards.'
    : 'Questo diagramma si legge meglio con più spazio orizzontale. Puoi chiudere il pannello di destra mentre lo studi e riaprirlo dopo.',
  hideLabel = isEn ? 'Hide right sidebar' : 'Nascondi pannello destro',
  showLabel = isEn ? 'Show right sidebar' : 'Mostra pannello destro',
} = Astro.props;
---

<aside class="toc-aside-hint" aria-label={title}>
  <div class="toc-aside-body">
    <p class="toc-aside-title">⚠️ {title}</p>
    <p class="toc-aside-text">{message}</p>
  </div>
  <button
    type="button"
    class="toc-aside-btn"
    data-toc-aside-toggle
    data-hide-label={hideLabel}
    data-show-label={showLabel}
    aria-pressed="false"
  >
    <svg
      class="toc-aside-icon"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <rect
        x="1.5"
        y="2.5"
        width="13"
        height="11"
        rx="1.5"
        stroke="currentColor"
        stroke-width="1.3"
      />
      <line
        x1="10.5"
        y1="2.5"
        x2="10.5"
        y2="13.5"
        stroke="currentColor"
        stroke-width="1.3"
      />
      <rect
        class="toc-aside-panel-fill"
        x="11.2"
        y="3.2"
        width="2.6"
        height="9.6"
        rx="0.6"
        fill="currentColor"
      />
    </svg>
    <span class="toc-aside-btn-label">{hideLabel}</span>
  </button>
</aside>

<style>
  .toc-aside-hint {
    /* Colori in stile caution arancione con fallback leggibili */
    --caution-border: var(--sl-color-orange-high, #d97706);
    --caution-bg: color-mix(in srgb, var(--sl-color-orange, #f59e0b) 14%, transparent);
    --caution-title: var(--sl-color-orange-high, #b45309);

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-block: 1rem;
    padding: 0.85rem 1rem;
    border-inline-start: 3px solid var(--caution-border);
    border-radius: 0.375rem;
    background-color: var(--caution-bg);
  }

  :global(:root:not([data-theme='light'])) .toc-aside-hint {
    --caution-border: var(--sl-color-orange-high, #fbbf24);
    --caution-bg: color-mix(in srgb, var(--sl-color-orange, #f59e0b) 16%, transparent);
    --caution-title: var(--sl-color-orange-high, #fcd34d);
  }

  .toc-aside-body {
    flex: 1 1 20rem;
  }

  .toc-aside-title {
    margin: 0 0 0.25rem;
    font-weight: 600;
    color: var(--caution-title);
  }

  .toc-aside-text {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text);
  }

  .toc-aside-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--caution-border);
    border-radius: 0.375rem;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .toc-aside-btn:hover {
    background-color: var(--caution-bg);
  }

  .toc-aside-btn[aria-pressed='true'] {
    border-color: var(--caution-border);
  }

  .toc-aside-btn[aria-pressed='true'] .toc-aside-panel-fill {
    opacity: 0.15;
  }

  .toc-aside-icon {
    flex-shrink: 0;
  }
</style>

<script>
  const STORAGE_KEY = 'stics-hide-toc';

  function syncTocControls(hidden: boolean) {
    document.documentElement.dataset.tocHidden = hidden ? 'true' : 'false';

    // Sincronizza l'icona nell'header, se presente
    const headerBtn = document.getElementById('toc-toggle') as HTMLButtonElement | null;
    if (headerBtn) {
      headerBtn.setAttribute('aria-pressed', String(hidden));
    }

    // Sincronizza tutti i pulsanti dentro gli aside della pagina
    const asideBtns = document.querySelectorAll<HTMLButtonElement>('[data-toc-aside-toggle]');
    asideBtns.forEach((btn) => {
      const hideText = btn.dataset.hideLabel || 'Nascondi pannello destro';
      const showText = btn.dataset.showLabel || 'Mostra pannello destro';
      btn.setAttribute('aria-pressed', String(hidden));

      const labelEl = btn.querySelector<HTMLElement>('.toc-aside-btn-label');
      if (labelEl) {
        labelEl.textContent = hidden ? showText : hideText;
      } else {
        btn.textContent = hidden ? showText : hideText;
      }
    });
  }

  function initTocAsideHints() {
    const initialHidden = localStorage.getItem(STORAGE_KEY) === 'true';
    syncTocControls(initialHidden);

    const asideBtns = document.querySelectorAll<HTMLButtonElement>('[data-toc-aside-toggle]');
    asideBtns.forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const nextHidden = document.documentElement.dataset.tocHidden !== 'true';
        localStorage.setItem(STORAGE_KEY, String(nextHidden));
        syncTocControls(nextHidden);
      });
    });
  }

  initTocAsideHints();
  document.addEventListener('astro:after-swap', initTocAsideHints);
</script>
---
import { Aside } from '@astrojs/starlight/components';

interface Props {
  title?: string;
}

const isEn = Astro.url.pathname.startsWith('/en/');

const { title = isEn ? 'Key Concepts' : 'Concetti chiave',} = Astro.props;

---

<Aside type="note" title={title} icon="puzzle">
  <slot />
</Aside>
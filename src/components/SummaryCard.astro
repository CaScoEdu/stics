---
import {
    Aside,
} from "@astrojs/starlight/components";

import StepCard from '@/components/StepCard.astro';
import Checklist from '@/components/Checklist.astro';

interface Props {
	keyConceptsTitle: string;
	checklistTitle: string;
    rewardTitle: string;
}

const { 
    keyConceptsTitle,
    checklistTitle,
    rewardTitle, 
    } = Astro.props;
---

<StepCard>

<slot />

<Aside type="note" title={keyConceptsTitle} icon="puzzle">
    <slot name="keyConcepts" />
</Aside>

<Checklist id="introduzione-sincronizzazione-processi-check" title={checklistTitle}>
<slot name="checklist" />
<Aside type="tip" title={rewardTitle} slot="reward" icon="star">
 <slot name="rewardText" />   
</Aside>
</Checklist>

</StepCard>

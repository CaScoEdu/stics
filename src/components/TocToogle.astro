---
const isEn = Astro.url.pathname.startsWith('/en/');
const label = isEn ? 'Toggle right sidebar' : 'Mostra/nascondi pannello destro';
---
<button
  id="toc-toggle"
  type="button"
  aria-pressed="false"
  aria-label={label}
  title={label}
  class="toc-icon-btn"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 16 16"
    fill="none"
    aria-hidden="true"
  >
    <rect
      x="1.5"
      y="2.5"
      width="13"
      height="11"
      rx="1.5"
      stroke="currentColor"
      stroke-width="1.3"
    />
    <line
      x1="10.5"
      y1="2.5"
      x2="10.5"
      y2="13.5"
      stroke="currentColor"
      stroke-width="1.3"
    />
    <rect
      class="toc-panel-fill"
      x="11.2"
      y="3.2"
      width="2.6"
      height="9.6"
      rx="0.6"
      fill="currentColor"
    />
  </svg>
</button>

<style>
  .toc-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-1);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .toc-icon-btn:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }

  /* Quando il pannello destro è nascosto, svuotiamo il riempimento destro */
  :global(html[data-toc-hidden='true']) .toc-icon-btn .toc-panel-fill {
    opacity: 0.15;
  }

  :global(html[data-toc-hidden='true']) .toc-icon-btn {
    border-color: var(--sl-color-gray-5);
    color: var(--sl-color-accent-high);
  }
</style>

<script>
  const STORAGE_KEY = 'stics-hide-toc';

  function initTocToggle() {
    const btn = document.getElementById('toc-toggle') as HTMLButtonElement | null;
    if (!btn) return;

    const applyState = (hidden: boolean) => {
      document.documentElement.dataset.tocHidden = hidden ? 'true' : 'false';
      btn.setAttribute('aria-pressed', String(hidden));
    };

    applyState(localStorage.getItem(STORAGE_KEY) === 'true');

    if (!btn.dataset.bound) {
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const nextHidden = document.documentElement.dataset.tocHidden !== 'true';
        localStorage.setItem(STORAGE_KEY, String(nextHidden));
        applyState(nextHidden);
      });
    }
  }

  initTocToggle();
  document.addEventListener('astro:after-swap', initTocToggle);
</script>